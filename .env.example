DATABASE_URL=postgresql://cheaptravel:cheaptravel@localhost:5432/cheaptravel?schema=public
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional; the policy assistant uses local retrieval when unset.
AI_API_KEY=
# Set the exact API model ID accessible to your account, not a chat UI label.
AI_MODEL=
# The chosen API model must support this reasoning effort and structured output.
AI_REASONING_EFFORT=low
# Optional explicit model for the Responses web_search tool; otherwise AI_MODEL is used.
# Text-chat support does not establish web-search tool support.
AI_WEB_SEARCH_MODEL=
AI_WEB_SEARCH_REASONING_EFFORT=low
# Get credentials at developers.amadeus.com. Test inventory is NOT live market pricing.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
# Random secret to authorize the scheduled monitoring endpoint.
MONITOR_SECRET=
